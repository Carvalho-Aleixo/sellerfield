{
  "name": "sellerfield",
  "version": "0.1.0-dev",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "fixtures": "bun scripts/seed-fixtures.ts",
    "fixtures:check": "bun scripts/seed-fixtures.ts --check",
    "leak-check": "bun scripts/leak-check.ts",
    "test": "bun test test/",
    "gate": "bun run fixtures:check && bun run leak-check && bun run test",
    "demo": "bun src/server.ts",
    "test:e2e": "rm -rf test-results/screens && playwright test",
    "test:e2e:review": "rm -rf test-results/screens && E2E_BASELINE=skip playwright test",
    "test:e2e:update": "rm -rf test-results/screens && playwright test --update-snapshots"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0"
  }
}
